CHAT_ADDR=:8080
CHAT_DB_PATH=data/chat.db
CHAT_FRONTEND_DIR=frontend/dist
# Optional: comma-separated list of exact browser origins. Use explicit scheme.
# Subdomain wildcards must also include a scheme. "*" is rejected for cross-origin requests.
# CHAT_ALLOWED_ORIGINS=https://chat.example.com,https://*.example.com
# Optional: trusted reverse proxy CIDRs whose forwarded headers may drive rate
# limits and Turnstile's remoteip. Leave empty when directly exposed.
# Docker + host nginx: include 127.0.0.1/32 and the compose network subnet
# (inspect the network chosen by your compose deployment; do not hard-code a
# deployment-specific network name into shared configuration).
# CHAT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,192.168.32.0/20

# App session signing. Set a stable random value in shared/persistent deployments.
# OIDC mode requires it; OIDC-disabled local development may use an ephemeral value.
CHAT_SESSION_SECRET=
# tdchat_session is Secure by default. Set false only for loopback HTTP development.
CHAT_COOKIE_SECURE=true

# Cloudflare Turnstile on /api/login and /api/register. An empty secret disables
# server-side verification; set CHAT_TURNSTILE_REQUIRED=true in production so a
# missing secret stops startup instead of silently turning the check off.
# CHAT_TURNSTILE_SECRET=
# CHAT_TURNSTILE_HOSTNAMES=chat.example.com
# CHAT_TURNSTILE_ACTION=login
# CHAT_TURNSTILE_REQUIRED=false

# Assistant identity.
CHAT_BOT_NAME=TokenBot

# Free-demo budget. 0 disables a particular limit.
# Per guest/user replies per HKT day.
# CHAT_BOT_DAILY_PER_USER=50
# Per client IP replies per day (guests can rotate names).
# CHAT_BOT_DAILY_PER_IP=200
# Whole-instance daily reply and token caps.
# CHAT_BOT_DAILY_REPLIES=800
# CHAT_BOT_DAILY_TOKENS=3000000
# Concurrent model calls.
# CHAT_BOT_MAX_CONCURRENT=4
# Chat messages per client IP (IPv6 /64) in a 10-second window, across tabs.
# CHAT_MSG_PER_IP_PER_10S=80

# TokenBot LLM (OpenAI Chat Completions; official openai-go SDK).
# CHAT_LLM_PROVIDER is only a label: DeepSeek, OpenAI, and TokenDance Gateway
# all speak the same /v1/chat/completions protocol.
CHAT_LLM_PROVIDER=openai
# TokenDance Gateway (production): https://api.tokendancelab.com/v1
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com
CHAT_LLM_BASE_URL=https://api.tokendancelab.com/v1
# Primary production model:
#   deepseek-v4.1-flash
# Other DeepSeek V4 series:
#   deepseek-v4-pro   — flagship reasoning model
#   deepseek-v4-flash — fast/cheap model
CHAT_LLM_MODEL=deepseek-v4.1-flash
CHAT_LLM_API_KEY=
CHAT_LLM_MAX_TOKENS=4096
# Optional generation controls.
# CHAT_LLM_TEMPERATURE=
# CHAT_LLM_TOP_P=
# CHAT_LLM_TIMEOUT=90s
# CHAT_LLM_MAX_TOOL_ROUNDS=3
# CHAT_LLM_REASONING_EFFORT=
# Conversation window, in messages. The SQLite transcript is the memory;
# there is no separate memory file.
# CHAT_LLM_MEMORY_SIZE=20
CHAT_LLM_MEMORY_SIZE=20

# TokenDance Account OIDC integration.
# Chat is a confidential relying party. The browser receives only Chat's session cookie.
# Production issuer is https://account.tokendancelab.com.
CHAT_OIDC_ENABLED=false
CHAT_OIDC_ISSUER=https://account.tokendancelab.com
CHAT_OIDC_CLIENT_ID=
# Required when OIDC is enabled; keep it in the deployment secret store.
CHAT_OIDC_CLIENT_SECRET=
# Use a separate client for localhost and every deployed origin.
CHAT_OIDC_REDIRECT_URI=http://localhost:8080/api/oidc/callback
# Exact Account-registered post-logout destination. If omitted, Chat derives
# "/api/logout/account/callback" from CHAT_OIDC_REDIRECT_URI's origin.
# Production: https://chat.tokendancelab.com/api/logout/account/callback
CHAT_OIDC_POST_LOGOUT_REDIRECT_URI=
